{{- /*
  Generated by `chezmoi init`. Asks once per machine which optional components
  to install; answers are remembered in ~/.config/chezmoi/chezmoi.toml. To
  change an answer later: `chezmoi init --prompt` (or edit that file).
*/ -}}
{{- $aiAgents  := promptBoolOnce . "aiAgents"  "Install AI agent CLIs (Claude Code/Codex/Gemini/OpenCode)" true -}}
{{- $docker    := promptBoolOnce . "docker"    "Install Docker (Linux only)" false -}}
{{- $tailscale := promptBoolOnce . "tailscale" "Install Tailscale" false -}}

# Points chezmoi at this repo wherever it was cloned.
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  aiAgents  = {{ $aiAgents }}
  docker    = {{ $docker }}
  tailscale = {{ $tailscale }}

[gitHub]
  # Cache GitHub "latest release" lookups used by .chezmoiexternal.toml.tmpl,
  # so `chezmoi apply` doesn't hit the API (60 req/h unauthenticated) each run.
  refreshPeriod = "24h"
